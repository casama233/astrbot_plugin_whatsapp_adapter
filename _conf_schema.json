{
  "gateway_host": {
    "description": "Gateway HTTP 绑定地址",
    "type": "string",
    "default": "127.0.0.1",
    "group": "connection",
    "hint": "除非 AstrBot 和 Gateway 分别运行在不同容器，否则建议保持 127.0.0.1。"
  },
  "gateway_port": {
    "description": "Gateway HTTP 端口",
    "type": "int",
    "default": 18789,
    "group": "connection",
    "hint": "Gateway HTTP/SSE 端口，预设 18789。"
  },
  "auto_start_gateway": {
    "description": "自动启动内置 Gateway",
    "type": "bool",
    "default": true,
    "group": "connection",
    "hint": "启用后，打开插件登录页时会自动启动 Node.js Gateway；平台实例也有独立的同名配置。"
  },
  "node_executable": {
    "description": "Node.js 可执行文件",
    "type": "string",
    "default": "node",
    "group": "connection",
    "hint": "推荐 Node.js 20+，例如 node 或 /usr/bin/node。"
  },
  "auth_dir": {
    "description": "WhatsApp 登录态目录",
    "type": "string",
    "default": "",
    "group": "connection",
    "hint": "留空时使用 AstrBot 工作目录下的 data/plugin_data/astrbot_plugin_whatsapp_adapter/whatsapp-auth。"
  },
  "log_level": {
    "description": "Gateway 日志级别",
    "type": "string",
    "default": "info",
    "group": "connection",
    "hint": "可选：silent、fatal、error、warn、info、debug、trace。",
    "options": [
      "silent",
      "fatal",
      "error",
      "warn",
      "info",
      "debug",
      "trace"
    ]
  },
  "default_link_preview_single_url": {
    "description": "默认启用单链接预览",
    "type": "bool",
    "default": true,
    "group": "messaging_defaults",
    "hint": "所有 WhatsApp 平台实例的全局默认值；仅当纯文字消息只包含一个 URL 时生成预览。"
  },
  "default_typing_indicator": {
    "description": "默认发送输入状态",
    "type": "bool",
    "default": true,
    "group": "messaging_defaults",
    "hint": "所有 WhatsApp 平台实例的全局默认值。"
  },
  "default_send_read_receipts": {
    "description": "默认发送已读回执",
    "type": "bool",
    "default": true,
    "group": "messaging_defaults",
    "hint": "所有 WhatsApp 平台实例的全局默认值。"
  },
  "default_mark_online": {
    "description": "默认标记在线状态",
    "type": "bool",
    "default": false,
    "group": "messaging_defaults",
    "hint": "所有 WhatsApp 平台实例的全局默认值。"
  },
  "default_parse_inbound_formatting": {
    "description": "默认解析入站格式",
    "type": "bool",
    "default": true,
    "group": "messaging_defaults",
    "hint": "将 WhatsApp 原生粗体、斜体、删除线和代码转换为 Markdown 供 AstrBot 阅读。"
  },
  "default_media_album_debounce_seconds": {
    "description": "默认相簿去抖时间（秒）",
    "type": "float",
    "default": 2.5,
    "group": "messaging_defaults",
    "hint": "连续无文字图片合并为相簿的全局等待时间；设为 0 关闭。"
  },
  "default_streaming_edit_throttle": {
    "description": "默认流式编辑间隔（秒）",
    "type": "float",
    "default": 1.0,
    "group": "messaging_defaults",
    "hint": "所有 WhatsApp 平台实例编辑流式文字的全局最小间隔。"
  }
}
