{
  "gateway_host": {
    "description": "Gateway HTTP 绑定地址",
    "type": "string",
    "default": "127.0.0.1",
    "group": "connection",
    "hint": "除非 AstrBot 和 Gateway 分别运行在不同容器，否则建议保持 127.0.0.1。"
  },
  "gateway_port": {
    "description": "Gateway HTTP 端口",
    "type": "int",
    "default": 18789,
    "group": "connection",
    "hint": "Gateway HTTP/SSE 端口，预设 18789。"
  },
  "auto_start_gateway": {
    "description": "自动启动内置 Gateway",
    "type": "bool",
    "default": true,
    "group": "connection",
    "hint": "启用后，打开插件登录页时会自动启动 Node.js Gateway；平台实例也有独立的同名配置。"
  },
  "node_executable": {
    "description": "Node.js 可执行文件",
    "type": "string",
    "default": "node",
    "group": "connection",
    "hint": "推荐 Node.js 20+，例如 node 或 /usr/bin/node。"
  },
  "auth_dir": {
    "description": "WhatsApp 登录态目录",
    "type": "string",
    "default": "",
    "group": "connection",
    "hint": "留空时使用 AstrBot 工作目录下的 data/plugin_data/astrbot_plugin_whatsapp_adapter/whatsapp-auth。"
  },
  "log_level": {
    "description": "Gateway 日志级别",
    "type": "string",
    "default": "info",
    "group": "connection",
    "hint": "可选：silent、fatal、error、warn、info、debug、trace。"
  }
}
